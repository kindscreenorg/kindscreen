# KindScreen Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to the repository

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Groq API (Phase 2 - audio transcription)
GROQ_API_KEY=

# Anthropic API (Phase 2 - frame analysis)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Donation milestone page — update this manually when funding changes
MONTHLY_DONATION_EUR=0
